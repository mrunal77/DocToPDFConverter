{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "client/dist",
  "buildCommand": "cd client && npm install && npm run build",
  "devCommand": "cd client && npm run dev",
  "installCommand": null,
  "framework": "vite",
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
